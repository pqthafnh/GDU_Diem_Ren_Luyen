APP_NAME=GDU Event & Training API
APP_ENV=development
APP_DEBUG=true
APP_HOST=0.0.0.0
APP_PORT=4000
DATABASE_URL=postgresql://gdu:gdu@localhost:5432/gdu_event_training
DATABASE_POOL_MIN_SIZE=2
DATABASE_POOL_MAX_SIZE=10
DATABASE_POOL_TIMEOUT_SECONDS=10
JWT_SECRET=change-this-development-secret
JWT_QR_SECRET=change-this-qr-secret
OTP_SECRET=change-this-otp-secret
JWT_EXPIRES_IN_MINUTES=1440
JWT_ISSUER=gdu-event-training
JWT_AUDIENCE=gdu-web
QR_TOKEN_TTL_SECONDS=30
OTP_TTL_MINUTES=5
OTP_MAX_ATTEMPTS=5
EXPOSE_TEST_OTP=false
CORS_ORIGINS=http://localhost:3000
